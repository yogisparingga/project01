# Backend configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-secret
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/streaming_app?schema=public
RTMP_PORT=1935
RTMP_HTTP_PORT=8000
RTMP_APP_NAME=live
FFMPEG_PATH=/usr/bin/ffmpeg

# Postgres configuration (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=streaming_app
